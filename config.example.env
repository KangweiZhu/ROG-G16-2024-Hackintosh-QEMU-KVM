# Copy to config.env and edit for your machine. config.env is git-ignored.
# Every script sources this file through scripts/lib.sh.

# --- dGPU to pass through ------------------------------------------------------
# `lspci -nnD | grep -i nvidia` — the GPU and its HDMI audio function.
# Both must be alone in their IOMMU group (see AGENTS.md, step 1).
GPU_PCI=0000:01:00.0
GPU_AUDIO_PCI=0000:01:00.1

# BAR1 size (log2 of MiB) while the GPU belongs to the VM. 8 = 256 MiB.
# A full-VRAM BAR1 (Resizable BAR, e.g. 8 GiB) makes the guest program a bogus
# address and QEMU aborts with KVM_SET_USER_MEMORY_REGION. Leave empty to keep
# the host's size (only if your GPU has no Resizable BAR or BAR1 is already small).
BAR1_VM_LOG2_MB=8

# --- host desktop --------------------------------------------------------------
# KDE Plasma (Wayland) keeps the dGPU open unless KWin is told to use only the iGPU.
# A colon-free path to the iGPU's DRM card node. If it doesn't exist, host.sh creates
# a udev rule for it from HOST_IGPU_PCI.
HOST_IGPU_PCI=0000:00:02.0
KWIN_DRM_DEVICE=/dev/dri/macos-vm-host-igpu

# --- VM ------------------------------------------------------------------------
VM_RAM_MIB=16384
VM_CORES=4            # physical cores shown to macOS; 4 or 8 (see CPU_NAME below)
VM_THREADS=2          # threads per core
MAC_USER=your-macos-user   # the account created in Setup Assistant (used by scripts/guest.sh)
SSH_PORT=2222         # host 127.0.0.1:SSH_PORT -> guest :22
VNC_PORT=5900         # host 127.0.0.1:VNC_PORT -> guest Screen Sharing

# Name shown in "About This Mac" (RestrictEvents). Empty = leave macOS' own name.
# Only works with VM_CORES=4 or 8: RestrictEvents rewrites one specific table entry
# per core count and opencore/patch-config.py sets the matching SMBIOS ProcessorType.
CPU_NAME="$(sed -n 's/^model name\s*: //p' /proc/cpuinfo | head -1 | sed 's/ w\/ .*//')"

# --- input ---------------------------------------------------------------------
# Fallback input: evdev passthrough of these devices (names from
# /proc/bus/input/devices, "N: Name=..."), separated by "|".
# Press both Shift keys to move them between host and VM.
EVDEV_DEVICES="AT Translated Set 2 keyboard|Logitech USB Receiver"
EVDEV_TOGGLE=shift-shift   # QEMU input-linux grab-toggle: ctrl-ctrl alt-alt shift-shift meta-meta scrolllock ctrl-scrolllock

# Deskflow (main input path once macOS is logged in): screen names and layout
# live in deskflow/. The guest reaches the host at 10.0.2.2 (QEMU user networking).
DESKFLOW_PORT=24800
