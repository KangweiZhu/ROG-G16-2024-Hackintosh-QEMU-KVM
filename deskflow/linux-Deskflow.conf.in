[core]
coreMode=2
computerName=linux
interface=127.0.0.1
port=@PORT@

[server]
externalConfig=true
externalConfigFile=@ROOT@/deskflow/server.conf
enableClipboard=true

[security]
tlsEnabled=false

[gui]
startCoreWithGui=true
enableUpdateCheck=false

[computer_linux]
name=linux

[computer_mac]
name=mac
